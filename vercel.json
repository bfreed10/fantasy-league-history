{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/draft-performance.js": {
      "maxDuration": 60
    },
    "api/trade-values.js": {
      "maxDuration": 60,
      "includeFiles": "data/trade_projection_feeds.json"
    }
  }
}
